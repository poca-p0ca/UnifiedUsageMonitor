/* Unified Usage Monitor — English (development language)

   Keys are grouped by where they appear. Every key also exists as a fallback
   literal in the Swift source, so this file and the code cannot drift apart
   silently: a missing key here shows the English text, never a raw key.

   To add a language, copy this file to <code>.lproj/Localizable.strings,
   translate the right-hand side, and add <code> to CFBundleLocalizations in
   Resources/Info.plist and to L10n.supported in Core/L10n.swift. */

/* MARK: Popover */
"popover.title" = "Remaining";
