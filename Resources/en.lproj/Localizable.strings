"popover.loading" = "Loading…";
"popover.empty.title" = "No tools detected";
"popover.empty.body" = "Install and sign in to Claude Code,\nCodex or Antigravity to see them here";
/* %@ is a duration such as "4h 12m" */
"popover.resetsIn" = "resets in %@";
/* %1$@ is a clock time, %2$@ the reason the last fetch failed */
"popover.staleCaption" = "as of %1$@ · %2$@";

/* MARK: Gauge */
/* Sits under the big number; the gauge reads what is left, not what is spent */
"gauge.remaining" = "left";

